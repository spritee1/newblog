---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="站内搜索" noindex>
	<div class="container">
		<div class="page-head">
			<h1>搜索</h1>
			<p>全文搜索，索引在构建时生成，不依赖任何后端服务。</p>
		</div>

		<div class="search-wrap">
			<div id="search"></div>
			<p class="search-note">
				没搜到？可以翻 <a href="/archive/">归档</a>，或者用浏览器的 Ctrl/⌘ + F。
			</p>
		</div>
	</div>

	<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
	<script src="/pagefind/pagefind-ui.js" is:inline></script>
	<script is:inline>
		window.addEventListener('DOMContentLoaded', () => {
			if (typeof PagefindUI === 'undefined') {
				document.getElementById('search').innerHTML =
					'<p class="search-note">搜索索引只在构建产物中存在，请先在本地执行 <code>pnpm build</code> 并通过 <code>pnpm preview</code> 预览。</p>';
				return;
			}
			const ui = new PagefindUI({
				element: '#search',
				showSubResults: true,
				showImages: false,
			});
			const q = new URLSearchParams(location.search).get('q');
			if (q) ui.triggerSearch(q);
		});
	</script>
</BaseLayout>
